# Server-only Vercel environment variables. Copy only the names and supply each
# environment's own values from its credentials. Keep this file as placeholders.

# Use prod in Production and sandbox in Preview / Development.
DATA_PREFIX=sandbox
DRIVEFX_DATABASE_URL=postgresql://drivefx_app.PROJECT_REF:PERCENT_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# DRIVEFX_DATABASE_CA=PEM_CERTIFICATE_FROM_SUPABASE_WHEN_REQUIRED
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
TRIAL_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Use dedicated DriveFX sandbox keys in Preview / Development and live keys in Production.
STRIPE_KEY=rk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PORTAL_MODE=link
# TERMS_CONSENT=1
CHECKOUT_ENABLED=0
MANAGED_PAYMENTS_COUNTRY_GATE_VERIFIED=0

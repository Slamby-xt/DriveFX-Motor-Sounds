# Placeholders only. Real values live in Vercel (Project > Settings > Environment Variables) as server-only variables. Never commit a real .env file.

# --- Stripe (Production = live keys, Preview/Development = sandbox/test keys) ---
STRIPE_KEY=rk_live_REPLACE_ME            # restricted key; sk_test_/rk_test_ in Preview
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME   # signing secret of the DEPLOYED endpoint (not the `stripe listen` one)

# --- App ---
ADMIN_TOKEN=REPLACE_WITH_14_PLUS_CHARACTERS   # admin panel password (header X-Admin-Token)
TRIAL_PEPPER=REPLACE_WITH_RANDOM_STRING       # key for the trial-ledger hashes (changing it forgets existing trials)
DATA_PREFIX=prod                              # "prod" in Production, "sandbox" in Preview/Development (enforced in code)
TERMS_CONSENT=1                               # optional: terms checkbox at checkout
# TAX=1                                       # optional: Stripe Tax at checkout

# --- Redis (injected automatically by the Vercel Upstash integration; do not hand-edit) ---
KV_REST_API_URL=https://REPLACE_ME.upstash.io
KV_REST_API_TOKEN=REPLACE_ME

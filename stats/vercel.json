{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:r(collect|stats)", "destination": "/api?__r=:r" },
    { "source": "/:r(collect|stats)", "destination": "/api?__r=:r" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Strict-Transport-Security", "value": "max-age=31536000" } ] },
    { "source": "/t.js", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" }, { "key": "Access-Control-Allow-Origin", "value": "*" } ] }
  ]
}
